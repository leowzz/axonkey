{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axonkey",
  "version": "1.0.19",
  "identifier": "com.axonkey.app",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build:tauri",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web-dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Axonkey",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwRTU5Qjk2OTU5QkYyNjUKUldSbDhwdVZscHZsWU5MRi9PdGVZMlpzQTZEV29rbWNXUnc0Q1pWaFNYRGJTYkNWTFlUM05TL3kK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
