{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axonkey",
  "version": "0.1.5",
  "identifier": "com.axonkey.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "title": "Axonkey",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true
  }
}
