{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "category": "Utility",
    "resources": [
      "resources/macos"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "infoPlist": "Info.macos.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Axonkey",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "transparent": true,
        "theme": "Light",
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        },
        "titleBarStyle": "Overlay"
      }
    ]
  }
}
