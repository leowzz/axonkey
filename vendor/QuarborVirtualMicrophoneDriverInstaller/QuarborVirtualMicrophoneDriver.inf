[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer = 11/01/2026,0.2.0.2
CatalogFile = QuarborVirtualMicrophoneDriver.cat
PnpLockDown = 1

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
QuarborVirtualMicrophoneDriver.sys = 1

[Manufacturer]
%MfgName% = QuarborVirtualMicrophone,NTamd64.10.0...17763

[QuarborVirtualMicrophone.NTamd64.10.0...17763]
%DeviceDesc% = QuarborVirtualMicrophone,ROOT\QUARBORVIRTUALMICROPHONE

[DestinationDirs]
QuarborVirtualMicrophone.CopyList = 13

[QuarborVirtualMicrophone.CopyList]
QuarborVirtualMicrophoneDriver.sys

[QuarborVirtualMicrophone.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,QuarborVirtualMicrophoneDriver.sys
HKR,,FriendlyName,,%DeviceDesc%
HKR,Branding,icon,,"%13%\QuarborVirtualMicrophoneDriver.sys,101"
HKR,%MediaCategories%\%MicPinName%,Name,,%DeviceDesc%
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDesc%


[QuarborVirtualMicrophone.HW.AddReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[QuarborVirtualMicrophone.NT]
Include = ks.inf,wdmaudio.inf
Needs = KS.Registration,WDMAUDIO.Registration
CopyFiles = QuarborVirtualMicrophone.CopyList
AddReg = QuarborVirtualMicrophone.AddReg
AddProperty = QuarborVirtualMicrophone.DeviceIcon

[QuarborVirtualMicrophone.DeviceIcon]
DeviceIcon,,,"%13%\QuarborVirtualMicrophoneDriver.sys,-101"

[QuarborVirtualMicrophone.NT.HW]
AddReg = QuarborVirtualMicrophone.HW.AddReg

[QuarborVirtualMicrophone.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_WaveMicArray1%,QuarborVirtualMicrophone.I.Wave
AddInterface = %KSCATEGORY_REALTIME%,%KSNAME_WaveMicArray1%,QuarborVirtualMicrophone.I.Wave
AddInterface = %KSCATEGORY_CAPTURE%,%KSNAME_WaveMicArray1%,QuarborVirtualMicrophone.I.Wave
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_TopologyMicArray1%,QuarborVirtualMicrophone.I.Topology
AddInterface = %KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyMicArray1%,QuarborVirtualMicrophone.I.Topology

[QuarborVirtualMicrophone.I.Wave]
AddReg = QuarborVirtualMicrophone.I.Wave.AddReg

[QuarborVirtualMicrophone.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveName%

[QuarborVirtualMicrophone.I.Topology]
AddReg = QuarborVirtualMicrophone.I.Topology.AddReg

[QuarborVirtualMicrophone.I.Topology.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
HKR,EP\0,%PKEY_AudioEndpointLogo_IconPath%,,"%13%\QuarborVirtualMicrophoneDriver.sys,-101"
HKR,EP\0,%PKEY_DeviceClass_IconPath%,,"%13%\QuarborVirtualMicrophoneDriver.sys,-101"
HKR,EP\0,%PKEY_AudioEngine_OEMFormat%,%REG_BINARY%,41,00,00,00,28,00,00,00,FE,FF,02,00,80,BB,00,00,00,EE,02,00,04,00,10,00,16,00,10,00,03,00,00,00,01,00,00,00,00,00,10,00,80,00,00,AA,00,38,9B,71

[QuarborVirtualMicrophone.NT.Services]
AddService = QuarborVirtualMicrophoneDriver,0x00000002,QuarborVirtualMicrophone.Service

[QuarborVirtualMicrophone.Service]
DisplayName = %ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\QuarborVirtualMicrophoneDriver.sys

[QuarborVirtualMicrophone.NT.Wdf]
KmdfService = QuarborVirtualMicrophoneDriver,QuarborVirtualMicrophone.Wdf

[QuarborVirtualMicrophone.Wdf]
KmdfLibraryVersion = 1.27

