[Version]
Signature = "$WINDOWS NT$"
Class = Keyboard
ClassGuid = {4D36E96B-E325-11CE-BFC1-08002BE10318}
Provider = %ManufacturerName%
CatalogFile = QuarborHIDFilterUserDriver.cat
DriverVer = 10/22/2026,0.4.0.1
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
QuarborHIDFilterUserDriver.dll = 1

[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%ManufacturerName% = Standard, NTamd64.10.0...17134, NTamd64.10.0...22000

[Standard.NTamd64.10.0...17134]
%DeviceDesc% = QuarborHIDFilterUserDriver_Install, QUARBOR\HidKeyboardManualBinding

[Standard.NTamd64.10.0...22000]
%DeviceDesc% = QuarborHIDFilterUserDriver_Install.Modern, QUARBOR\HidKeyboardManualBinding

[QuarborHIDFilterUserDriver_Install.Modern.NT]
CopyFiles = UMDriverCopy
Include = keyboard.inf, WUDFRD.inf
Needs = HID_Keyboard_Inst.NT, WUDFRD_LowerFilter.NT

[QuarborHIDFilterUserDriver_Install.Modern.NT.hw]
Include = keyboard.inf, WUDFRD.inf
Needs = HID_Keyboard_Inst.NT.HW, WUDFRD_LowerFilter.NT.HW

[QuarborHIDFilterUserDriver_Install.Modern.NT.Services]
Include = keyboard.inf, WUDFRD.inf
Needs = HID_Keyboard_Inst.NT.Services, WUDFRD_LowerFilter.NT.Services

[QuarborHIDFilterUserDriver_Install.Modern.NT.Filters]
Include = WUDFRD.inf
Needs = WUDFRD_LowerFilter.NT.Filters

[QuarborHIDFilterUserDriver_Install.Modern.NT.Wdf]
UmdfService = QuarborHIDFilterUserDriver, QuarborHIDFilterUserDriver_Install
UmdfServiceOrder = QuarborHIDFilterUserDriver
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy = AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction = Copy
UmdfFsContextUsePolicy = CannotUseFsContexts

[QuarborHIDFilterUserDriver_Install.NT]
CopyFiles = UMDriverCopy
Include = keyboard.inf
Needs = HID_Keyboard_Inst.NT

[QuarborHIDFilterUserDriver_Install.NT.hw]
Include = keyboard.inf
Needs = HID_Keyboard_Inst.NT.HW
AddReg = ReflectorLowerFilter

[QuarborHIDFilterUserDriver_Install.NT.Services]
Include = keyboard.inf
Needs = HID_Keyboard_Inst.NT.Services
; Preserve an existing system reflector service; kbdhid remains the function driver.
AddService = WUDFRd,0x000001f8,ReflectorService

; Windows 10 only: WUDFRD.inf is absent. Windows 11 selects the Modern model above.
[ReflectorLowerFilter]
HKR,,LowerFilters,0x00010008,"WUDFRd"

[ReflectorService]
DisplayName = "Windows Driver Frameworks - User-mode Driver Framework Reflector"
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[QuarborHIDFilterUserDriver_Install.NT.Wdf]
UmdfService = QuarborHIDFilterUserDriver, QuarborHIDFilterUserDriver_Install
UmdfServiceOrder = QuarborHIDFilterUserDriver
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy = AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction = Copy
UmdfFsContextUsePolicy = CannotUseFsContexts

[QuarborHIDFilterUserDriver_Install]
UmdfLibraryVersion = 2.25.0
ServiceBinary = %13%\QuarborHIDFilterUserDriver.dll

[UMDriverCopy]
QuarborHIDFilterUserDriver.dll

[Strings]
ManufacturerName = "Quarbor Logic Technologies Inc."
DiskName = "Quarbor HID User Filter Installation Disk"
DeviceDesc = "Quarbor HID Filter Driver - Intercepts and modifies HID input reports before completion"
